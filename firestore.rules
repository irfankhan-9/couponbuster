rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: is this particular field the only change?
    // Used to gate writes to a single path so admins can edit earned_titles,
    // displayed_title_id, pinned_title_ids without being able to edit other fields.
    function onlyChangedFields(allowedPaths) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(allowedPaths);
    }

    // USERS
    // Anyone signed in can read user profiles (needed for leaderboards)
    // Self can edit their own profile (cannot stomp on admin-managed fields)
    // Any signed-in user can update the admin-managed fields on ANY user
    // doc — used by the client-side admin Titles panel while Cloud
    // Functions are not deployed. Once functions are deployed, tighten
    // this to a global-admin server-side check.
    match /users/{userId} {
      allow read: if isSignedIn();

      // Self write — non-admins may not stomp on the admin-managed fields.
      allow update: if isSignedIn() && request.auth.uid == userId
        && (!('earned_titles' in request.resource.data) ||
            request.resource.data.earned_titles == resource.data.earned_titles)
        && (!('displayed_title_id' in request.resource.data) ||
            request.resource.data.displayed_title_id == resource.data.displayed_title_id)
        && (!('pinned_title_ids' in request.resource.data) ||
            request.resource.data.pinned_title_ids == resource.data.pinned_title_ids);

      // Any signed-in user may update the admin-managed fields on any user.
      // The Admin page UI gates this behind league-admin / global-admin.
      allow update: if isSignedIn()
        && onlyChangedFields(['earned_titles', 'displayed_title_id', 'pinned_title_ids']);

      // Other writes (create / delete) — only self.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // LEAGUES
    // Anyone can read leagues (for directory)
    // Authenticated users can create leagues
    // Only the owner can update the league settings
    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.owner_id ||
        (resource.data.league_admins != null && request.auth.uid in resource.data.league_admins)
      );
      allow delete: if isSignedIn();
    }

    // MEMBERS
    // Authenticated users can read memberships
    // Anyone can create a membership request (Join)
    // Updates/Deletes should ideally be restricted to League Admins, but for MVP we allow auth users
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // WEEKS
    // Authenticated users can read weeks
    // Creation/Updates restricted to admins (but for MVP allowing auth users to support Admin Panel)
    match /weeks/{weekId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // PICKS
    // Authenticated users can read picks
    // Authenticated users can create/update picks (DraftRoom/Dashboard)
    match /picks/{pickId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // LEAGUE CHAMPIONS
    // Anyone signed in can read (for global leaderboard)
    // Only Firebase Admin SDK (Cloud Functions) can write
    match /league_champions/{leagueId} {
      allow read: if isSignedIn();
      allow write: if false; // Only Cloud Functions can update
    }

    // GLOBAL LEAGUE
    // Global league configuration - anyone signed in can read, admins can update
    match /global_league/{leagueId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // GLOBAL LEAGUE ENTRIES
    // Entries for global championship - anyone signed in can read/write
    match /global_league_entries/{entryId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // GLOBAL LEAGUE REQUESTS
    // Join requests for global league - anyone signed in can create/read
    match /global_league_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // ADMIN TITLES
    // Admin-defined title templates (e.g. "Plumbing League Champion").
    // Read = any signed-in user (so client can render granted titles).
    // Write = any signed-in user (client-mode fallback while Cloud Functions
    // aren't deployed). The Admin page UI gates this behind league-admin /
    // global-admin. Once functions are deployed, tighten this to a
    // server-side global-admin check.
    match /admin_titles/{adminTitleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
